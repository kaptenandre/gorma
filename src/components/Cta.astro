---
// A link that may still be a placeholder (TBA). Placeholders keep the exact
// look of the real button but have no href, so they go nowhere.
interface Props {
  href: string;
  class?: string;
  [attr: string]: unknown;
}

const { href, class: className, ...attrs } = Astro.props;
const external = /^https?:/.test(href);
---

{
  href ? (
    <a
      class={className}
      href={href}
      target={external ? "_blank" : undefined}
      rel={external ? "noopener" : undefined}
      {...attrs}
    >
      <slot />
    </a>
  ) : (
    <a class={className} aria-disabled="true" data-tba {...attrs}>
      <slot />
    </a>
  )
}
